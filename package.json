{
  "name": "elpx-validator",
  "version": "1.2.0",
  "description": "Validate eXeLearning .elpx and .elp packages: structure, navigation, iDevices, assets and EDIA quality criteria. CLI, static in-browser web app and Agent Skill.",
  "license": "AGPL-3.0-or-later",
  "author": "Área de Tecnología Educativa",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ateeducacion/elpx-validator.git"
  },
  "homepage": "https://ateeducacion.github.io/elpx-validator/",
  "keywords": [
    "exelearning",
    "elpx",
    "elp",
    "validator",
    "education",
    "oer",
    "cli"
  ],
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "elpx-validator": "bin/elpx-validator.js"
  },
  "main": "js/validator.js",
  "exports": {
    ".": "./js/validator.js",
    "./cli": "./js/cli.js",
    "./package.json": "./package.json"
  },
  "files": [
    "bin/",
    "js/",
    "!js/app.js",
    "!js/shell.js",
    "!js/theme.js",
    "!js/preview/",
    "!js/edia/edia-view.js"
  ],
  "scripts": {
    "start": "http-server -c-1 .",
    "cli": "node bin/elpx-validator.js",
    "lint": "bun lint && bun fmt --check",
    "fix": "bun lint --fix && bun fmt",
    "format": "bun fmt",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "check:lockfile": "bun scripts/check-lockfile.js",
    "check": "bun run lint && bun run test:coverage",
    "vendor": "cp node_modules/jszip/dist/jszip.min.js vendor/jszip.min.js"
  },
  "dependencies": {
    "jsdom": "^31.0.1",
    "jszip": "^3.10.2"
  },
  "devDependencies": {
    "http-server": "^14.1.1"
  },
  "packageManager": "bun@1.4.5"
}
